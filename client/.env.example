# Leave blank for local development through the Vite proxy.
VITE_API_URL=
VITE_SOCKET_URL=

# Demo credentials for local seeded accounts:
# Rider: alex@example.com / rider123
# Driver: michael.driver@example.com / driver123
# Admin credentials are configured only in server/.env.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# For a separately deployed backend, use full URLs instead:
# VITE_API_URL=https://api.example.com/api
# VITE_SOCKET_URL=https://api.example.com